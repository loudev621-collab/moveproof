# Copy to .env.local (same folder as package.json) and fill in.
# Add the same names in Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Enable only after configuring the provider in Supabase Authentication.
NEXT_PUBLIC_AUTH_GOOGLE=off
NEXT_PUBLIC_AUTH_APPLE=off
# SECRET: server only. Never put NEXT_PUBLIC_ in front of this one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Your site address, no trailing slash. Live: https://getdoorstamp.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe > Developers > API keys (start in test mode)
STRIPE_SECRET_KEY=sk_test_...
# Stripe > Developers > Webhooks (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe > Product catalog: ONE product, "Move Pass", one-time $9. Copy its price ID.
# (The old name STRIPE_PRICE_HOME_PASS still works, so you can keep your existing value.)
STRIPE_PRICE_MOVE_PASS=price_...

# Time zone printed in reports. California homes: America/Los_Angeles
REPORT_TIMEZONE=America/Los_Angeles
