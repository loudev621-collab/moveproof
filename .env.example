# Copy to .env.local (same folder as package.json) and fill in.
# Add the same names in Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SECRET: server only. Never put NEXT_PUBLIC_ in front of this one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Your site address, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe > Developers > API keys (start in test mode)
STRIPE_SECRET_KEY=sk_test_...
# Stripe > Developers > Webhooks (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe > Product catalog: create two products and copy their price IDs
STRIPE_PRICE_HOME_PASS=price_...
STRIPE_PRICE_LANDLORD=price_...

# Time zone printed in reports, e.g. America/Phoenix, America/New_York
REPORT_TIMEZONE=America/Phoenix
